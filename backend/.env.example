# Copy this file to credentials.env and fill in real values.
# Never commit credentials.env -- it's already in .gitignore.

# MongoDB
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_STRING=mongodb+srv://your-db-username:<db_password>@your-cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=Hate_App

# Gemini (used for the Gemini model and the feedback generator)
GEMINI_API_KEY=your-gemini-api-key

# Ollama (self-hosted or Cloud Run endpoint)
OLLAMA_API_URL=https://your-ollama-endpoint

# Auth -- generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret

# Optional
PREDICTIONS_COLLECTION=predictions
